{
  "openapi": "3.0.3",
  "info": {
    "title": "RIC-O Linked Data API",
    "description": "Records in Contexts (RIC-O) ISO 23278 Linked Data API for Heratio archival management system",
    "version": "1.0.0",
    "contact": {
      "name": "Johan Pieterse",
      "email": "johan@plainsailingisystems.co.za"
    },
    "license": {
      "name": "AGPL-3.0",
      "url": "https://www.gnu.org/licenses/agpl-3.0"
    }
  },
  "servers": [
    {
      "url": "/api/ric/v1",
      "description": "Heratio RIC-O API"
    }
  ],
  "paths": {
    "/agents": {
      "get": {
        "summary": "List all agents",
        "description": "Returns a list of all agents (persons, corporate bodies, families) in RIC-O JSON-LD format",
        "tags": ["Agents (ISAAR-CPF)"],
        "responses": {
          "200": {
            "description": "List of agents",
            "content": {
              "application/ld+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/agents/{slug}": {
      "get": {
        "summary": "Get agent by slug",
        "tags": ["Agents (ISAAR-CPF)"],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agent in RIC-O format"
          },
          "404": {
            "description": "Agent not found"
          }
        }
      }
    },
    "/records": {
      "get": {
        "summary": "List all records",
        "description": "Returns a list of all records (information objects) in RIC-O JSON-LD format",
        "tags": ["Records (ISAD)"],
        "responses": {
          "200": {
            "description": "List of records"
          }
        }
      }
    },
    "/records/{slug}": {
      "get": {
        "summary": "Get record by slug",
        "tags": ["Records (ISAD)"],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Record in RIC-O format"
          },
          "404": {
            "description": "Record not found"
          }
        }
      }
    },
    "/records/{slug}/export": {
      "get": {
        "summary": "Export entire RecordSet",
        "description": "Exports the entire RecordSet hierarchy as RIC-O JSON-LD",
        "tags": ["Records (ISAD)"],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full RecordSet export"
          }
        }
      }
    },
    "/functions": {
      "get": {
        "summary": "List all functions",
        "tags": ["Functions (ISDF)"],
        "responses": {
          "200": {
            "description": "List of functions"
          }
        }
      }
    },
    "/functions/{id}": {
      "get": {
        "summary": "Get function by ID",
        "tags": ["Functions (ISDF)"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Function in RIC-O format"
          }
        }
      }
    },
    "/repositories": {
      "get": {
        "summary": "List all repositories",
        "tags": ["Repositories (ISDIAH)"],
        "responses": {
          "200": {
            "description": "List of repositories"
          }
        }
      }
    },
    "/repositories/{slug}": {
      "get": {
        "summary": "Get repository by slug",
        "tags": ["Repositories (ISDIAH)"],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Repository in RIC-O format"
          }
        }
      }
    },
    "/sparql": {
      "get": {
        "summary": "Execute SPARQL 1.1 query (GET)",
        "description": "Read-only SPARQL Query passthrough to the backing triplestore. Implements the openric-spec `sparql-access` Draft profile v0.1.0. Update operations (INSERT/DELETE/CLEAR/LOAD/DROP/CREATE/COPY/MOVE/ADD) are rejected with 403 + application/problem+json. Rate-limited at 60/minute/IP. Backend query timeout 30s.",
        "tags": ["SPARQL", "sparql-access"],
        "parameters": [
          {"name": "query", "in": "query", "required": true, "schema": {"type": "string"}, "description": "SPARQL 1.1 query string (SELECT / ASK / CONSTRUCT / DESCRIBE)."}
        ],
        "responses": {
          "200": {
            "description": "SPARQL 1.1 results. Content-Type is propagated from the backend per the request Accept header — application/sparql-results+json (default for SELECT/ASK), application/sparql-results+xml, text/csv, text/tab-separated-values, text/turtle (CONSTRUCT/DESCRIBE), application/ld+json (CONSTRUCT/DESCRIBE).",
            "content": {
              "application/sparql-results+json": {"schema": {"type": "object", "properties": {"head": {"type": "object"}, "results": {"type": "object"}}}}
            }
          },
          "400": {"description": "Malformed query (backend parse error). application/problem+json."},
          "403": {"description": "SPARQL Update operation rejected. application/problem+json with type=https://openric.org/errors/update-not-permitted."},
          "429": {"description": "Rate limit exceeded (60/minute/IP)."},
          "502": {"description": "SPARQL backend unavailable. application/problem+json."}
        }
      },
      "post": {
        "summary": "Execute SPARQL 1.1 query (POST)",
        "description": "Same surface as GET. Accepts the query either as `?query=` form field (Content-Type: application/x-www-form-urlencoded) or as the raw request body (Content-Type: application/sparql-query).",
        "tags": ["SPARQL", "sparql-access"],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {"schema": {"type": "object", "properties": {"query": {"type": "string"}}, "required": ["query"]}},
            "application/sparql-query": {"schema": {"type": "string"}}
          }
        },
        "responses": {
          "200": {"description": "Same as GET /sparql."},
          "400": {"description": "Malformed query."},
          "403": {"description": "SPARQL Update rejected."},
          "429": {"description": "Rate limit exceeded."},
          "502": {"description": "Backend unavailable."}
        }
      }
    },
    "/sparql/info": {
      "get": {
        "summary": "SPARQL dataset description (void:Dataset)",
        "description": "Returns a `void:Dataset` description of the queryable RDF graph: SPARQL endpoint URL, total triple count, vocabularies bound, license. Turtle by default; JSON-LD when `Accept: application/ld+json`. Triple count is cached for 5 minutes.",
        "tags": ["SPARQL", "sparql-access"],
        "responses": {
          "200": {
            "description": "void:Dataset description.",
            "content": {
              "text/turtle": {"schema": {"type": "string"}},
              "application/ld+json": {"schema": {"type": "object"}}
            }
          },
          "429": {"description": "Rate limit exceeded."}
        }
      }
    },
    "/graph": {
      "get": {
        "summary": "Get entity relationships",
        "tags": ["SPARQL & Graph"],
        "parameters": [
          {
            "name": "uri",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Entity graph"
          }
        }
      }
    },
    "/validate": {
      "post": {
        "summary": "Validate RIC-O entity",
        "tags": ["Validation"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation result"
          }
        }
      }
    },
    "/vocabulary": {
      "get": {
        "summary": "Get RIC-O vocabulary",
        "tags": ["Vocabulary"],
        "responses": {
          "200": {
            "description": "RIC-O vocabulary terms"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "API health check",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "API status"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Agent": {
        "type": "object",
        "properties": {
          "@id": {"type": "string"},
          "@type": {"type": "string"},
          "rico:identifier": {"type": "string"},
          "rico:name": {"type": "string"},
          "openricx:agentType": {"type": "string"}
        }
      },
      "Record": {
        "type": "object",
        "properties": {
          "@id": {"type": "string"},
          "@type": {"type": "string"},
          "rico:identifier": {"type": "string"},
          "rico:title": {"type": "string"},
          "rico:hasOrHadInstantiation": {"type": "array"}
        }
      },
      "Function": {
        "type": "object",
        "properties": {
          "@id": {"type": "string"},
          "@type": {"type": "string"},
          "rico:identifier": {"type": "string"},
          "rico:name": {"type": "string"}
        }
      },
      "Repository": {
        "type": "object",
        "properties": {
          "@id": {"type": "string"},
          "@type": {"type": "string"},
          "rico:name": {"type": "string"},
          "rico:location": {"type": "string"}
        }
      }
    }
  }
}
