#!/usr/bin/env bash
#===============================================================================
# OpenRiC release script
#===============================================================================
# Bumps version.json, prepends a CHANGELOG.md entry, commits, tags locally.
# Does NOT push — prints the push command for you to run. This matches the
# project rule: never push without explicit operator instruction.
#
# Usage:
#   ./bin/release patch "Short description"
#   ./bin/release minor "Feature X" --issue 42
#   ./bin/release major "Breaking change"
#
# Flags:
#   --issue N[,M,...]   Reference GitHub issues in commit + release notes.
#
# Hard requirements (bail on any failure):
#   - working tree clean
#   - current branch is main
#   - version.json parseable
#   - CHANGELOG.md exists
#===============================================================================
set -euo pipefail

# --- args -------------------------------------------------------------------
TYPE="${1:-}"
MSG="${2:-}"
ISSUE_ARG=""

shift 2 2>/dev/null || true
while [[ $# -gt 0 ]]; do
    case "$1" in
        --issue)
            ISSUE_ARG="${2:-}"
            shift 2
            ;;
        *)
            echo "Unknown arg: $1" >&2
            exit 2
            ;;
    esac
done

if [[ -z "$TYPE" || -z "$MSG" ]]; then
    cat <<EOF
Usage: ./bin/release patch|minor|major "commit message" [--issue N[,M,...]]

Examples:
  ./bin/release patch "Fix OntologyService SPARQL escape bug"
  ./bin/release minor "Phase 1 — RiC-O load + OntologyService" --issue 7
  ./bin/release major "Break: rename route prefix to /reference/ric-cm"
EOF
    exit 2
fi

case "$TYPE" in
    patch|minor|major) ;;
    *) echo "Error: TYPE must be patch|minor|major" >&2; exit 2 ;;
esac

# --- locate repo root -------------------------------------------------------
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

VERSION_FILE="version.json"
CHANGELOG="CHANGELOG.md"

# --- colours ----------------------------------------------------------------
if [[ -t 1 ]]; then
    RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
    BLUE='\033[0;34m'; CYAN='\033[0;36m'; NC='\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; BLUE=''; CYAN=''; NC=''
fi

printf "${CYAN}══════════════════════════════════════════════${NC}\n"
printf "${CYAN}  OpenRiC — Release${NC}\n"
printf "${CYAN}══════════════════════════════════════════════${NC}\n\n"

# --- preflight --------------------------------------------------------------
[[ -f "$VERSION_FILE" ]] || { printf "${RED}Error:${NC} %s not found\n" "$VERSION_FILE"; exit 1; }
[[ -f "$CHANGELOG" ]]    || { printf "${RED}Error:${NC} %s not found\n" "$CHANGELOG"; exit 1; }

BRANCH="$(git rev-parse --abbrev-ref HEAD)"
if [[ "$BRANCH" != "main" ]]; then
    printf "${RED}Error:${NC} Must be on 'main' (currently: %s)\n" "$BRANCH" >&2
    exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
    printf "${RED}Error:${NC} Working tree is not clean. Commit or stash first.\n" >&2
    git status --short >&2
    exit 1
fi

# --- parse current version --------------------------------------------------
CURRENT="$(php -r "\$j=json_decode(file_get_contents('${VERSION_FILE}'),true); echo \$j['version'] ?? '';")"
if [[ -z "$CURRENT" ]]; then
    printf "${RED}Error:${NC} Could not parse version from %s\n" "$VERSION_FILE" >&2
    exit 1
fi

MAJOR="$(echo "$CURRENT" | cut -d. -f1)"
MINOR="$(echo "$CURRENT" | cut -d. -f2)"
PATCH="$(echo "$CURRENT" | cut -d. -f3)"

case "$TYPE" in
    patch) PATCH=$((PATCH + 1)) ;;
    minor) MINOR=$((MINOR + 1)); PATCH=0 ;;
    major) MAJOR=$((MAJOR + 1)); MINOR=0; PATCH=0 ;;
esac

NEW_VERSION="${MAJOR}.${MINOR}.${PATCH}"
DATE="$(date +%Y-%m-%d)"
TAG="v${NEW_VERSION}"

printf "  Current: ${YELLOW}v%s${NC}\n" "$CURRENT"
printf "  New:     ${GREEN}%s${NC}\n" "$TAG"
printf "  Date:    %s\n" "$DATE"
printf "  Message: %s\n" "$MSG"
[[ -n "$ISSUE_ARG" ]] && printf "  Issues:  #%s\n" "$ISSUE_ARG"
printf "\n"

# --- update version.json ----------------------------------------------------
php -r "
\$j = json_decode(file_get_contents('${VERSION_FILE}'), true);
\$j['version'] = '${NEW_VERSION}';
\$j['release_date'] = '${DATE}';
file_put_contents('${VERSION_FILE}', json_encode(\$j, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . \"\n\");
"

# --- prepend CHANGELOG entry ------------------------------------------------
TMPFILE="$(mktemp)"
{
    # Keep the first line (the '# Changelog' heading) if present, then inject
    # the new entry below it.
    head -n 1 "$CHANGELOG"
    echo ""
    echo "## ${TAG} — ${DATE}"
    echo ""
    echo "- ${MSG}"
    if [[ -n "$ISSUE_ARG" ]]; then
        IFS=',' read -ra ISSUES <<< "$ISSUE_ARG"
        for issue in "${ISSUES[@]}"; do
            issue="$(echo "$issue" | tr -d ' ')"
            echo "- Closes #${issue}"
        done
    fi
    # Then the rest of the original file (skip first two lines: heading + blank).
    tail -n +3 "$CHANGELOG"
} > "$TMPFILE"
mv "$TMPFILE" "$CHANGELOG"

# --- commit + tag -----------------------------------------------------------
COMMIT_SUBJECT="${TAG}: ${MSG}"
COMMIT_BODY=""
if [[ -n "$ISSUE_ARG" ]]; then
    IFS=',' read -ra ISSUES <<< "$ISSUE_ARG"
    REFS=""
    for issue in "${ISSUES[@]}"; do
        issue="$(echo "$issue" | tr -d ' ')"
        [[ -z "$REFS" ]] && REFS="Closes #${issue}" || REFS="${REFS}, Closes #${issue}"
    done
    COMMIT_BODY="$REFS"
fi

printf "${BLUE}[1/2] Committing version bump...${NC}\n"
git add "$VERSION_FILE" "$CHANGELOG"
if [[ -n "$COMMIT_BODY" ]]; then
    git commit -m "$COMMIT_SUBJECT" -m "$COMMIT_BODY"
else
    git commit -m "$COMMIT_SUBJECT"
fi

printf "${BLUE}[2/2] Creating annotated tag ${TAG}...${NC}\n"
git tag -a "$TAG" -m "$MSG"

# --- summary (NO push) ------------------------------------------------------
printf "\n${GREEN}════════════════════════════════════════════════════════════════${NC}\n"
printf "${GREEN}  Release prepared locally. NOT PUSHED.${NC}\n"
printf "${GREEN}════════════════════════════════════════════════════════════════${NC}\n\n"

printf "  Commit: $(git rev-parse --short HEAD)\n"
printf "  Tag:    ${GREEN}${TAG}${NC}\n\n"

printf "To publish, run:\n\n"
printf "  ${CYAN}git push origin main${NC}\n"
printf "  ${CYAN}git push origin ${TAG}${NC}\n\n"

printf "To undo locally (before pushing):\n\n"
printf "  ${YELLOW}git tag -d ${TAG}${NC}\n"
printf "  ${YELLOW}git reset --hard HEAD~1${NC}\n\n"
