# Production .env example - secure defaults (do NOT commit real secrets)
# Copy this to your deployment host and replace values with real secrets via
# your secret manager or CI/CD pipeline.

APP_NAME=OpenRiC
APP_ENV=production
# Generate and set APP_KEY on the host (php artisan key:generate)
APP_KEY=
# Never enable debug in production
APP_DEBUG=false
# Replace with your real public site URL (use https)
APP_URL=https://your-production-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database (use a managed/postgres/mysql instance in production)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=openric
DB_USERNAME=openric
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=https
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@your-production-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

# Fuseki (SPARQL) backend - set to internal address if running on same host
FUSEKI_URL=http://127.0.0.1:3030
FUSEKI_DATASET_DATA=openric
FUSEKI_DATASET_MODEL=openric-model
# If Fuseki uses auth, inject these from your secret manager
FUSEKI_USER=
FUSEKI_PASSWORD=

# Frontend / admin
OPENRIC_FRONTEND_URL=https://your-frontend.example
OPENRIC_ADMIN_EMAIL=admin@your-production-domain.example

# Notes:
# - Do NOT commit secret values. Use your environment/secret manager to set
#   APP_KEY, DB_PASSWORD, MAIL_PASSWORD, FUSEKI_PASSWORD, etc.
# - Ensure APP_DEBUG=false and APP_ENV=production before exposing the service.
# - Terminate TLS at the edge and forward X-Forwarded-Proto so the app can
#   detect secure requests. The repository includes middleware to enforce
#   HTTPS and add security headers when APP_ENV=production.
# - Consider using a separate .env for runtime with your secret injector.
